#!/bin/sh
# Started by GDM as a session of its own (data/raum.desktop). raum takes the
# screen through DRM/KMS; this only gives it a log and the user's environment.
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/raum"
mkdir -p "$LOG_DIR"
[ -f "$LOG_DIR/session.log" ] && mv -f "$LOG_DIR/session.log" "$LOG_DIR/session.log.old"
# raum first, then GNOME: Chromium/Electron pick their keyring by this list
# and keep logins nowhere for a desktop they do not know.
export XDG_CURRENT_DESKTOP=raum:GNOME
export XDG_SESSION_DESKTOP=raum
# raum itself picks the NVIDIA card and only that one (WLR_DRM_DEVICES); the
# driver wants these for GBM-backed compositors and their clients.
if [ -e /proc/driver/nvidia/version ]; then
    export GBM_BACKEND="${GBM_BACKEND:-nvidia-drm}"
    export __GLX_VENDOR_LIBRARY_NAME="${__GLX_VENDOR_LIBRARY_NAME:-nvidia}"
fi
# raum started raum-session.target once its display was up. When it ends, so
# does graphical-session.target (raum-session-shutdown.target conflicts with
# it; raum starts that itself too) -- left running, GNOME refuses the next
# login -- and the user's services forget raum's display again.
end_session() {
    systemctl --user start --job-mode=replace-irreversibly raum-session-shutdown.target 2>/dev/null
    systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP 2>/dev/null
}
trap 'end_session; exit 143' TERM HUP INT
raum --shared-bus "$@" >"$LOG_DIR/session.log" 2>&1
status=$?
end_session
exit $status
